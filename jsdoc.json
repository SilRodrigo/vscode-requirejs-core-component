{
  "opts": {
    "template": "node_modules/jsdoc/templates/default",
    "destination": "doc",
    "recurse": true
  },
  "plugins": ["plugins/markdown"],
  "recurseDepth": 100,
  "source": {
    "include": ["src", "support/JSDOC.md"]
  },
  "tags": {
    "allowUnknownTags": true,
    "dictionaries": ["jsdoc", "closure"]
  },
  "templates": {
    "cleverLinks": true,
    "monospaceLinks": true
  }
}
